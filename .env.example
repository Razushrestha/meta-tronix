NEXT_PUBLIC_SITE_URL=https://www.meta-tronix.com

# Public read-only API (safe for the browser bundle). Create a project at https://www.sanity.io/manage
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
